# ==========================================
# DataPilot Git Ignore
# ==========================================

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# ==========================================
# Runtime generated outputs
# ==========================================

outputs/
output/

# Generated data / Office files
*.csv
*.xlsx
*.xls
*.docx

# Generated images
*.png
*.jpg
*.jpeg

# ==========================================
# Portfolio assets
# These are intentionally versioned
# ==========================================

!assets/
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.jpeg

# ==========================================
# Reproducible demo files
# ==========================================

!examples/
!examples/**/*.xlsx
!examples/**/*.csv

# ==========================================
# PyInstaller
# ==========================================

build/
dist/

# Keep PyInstaller specification
!DataPilot.spec

# ==========================================
# Testing / temporary files
# ==========================================

.pytest_cache/
.coverage
htmlcov/

*.tmp
*.temp
*.log
~$*

# Temporary repository inspection files
git_files.txt
git_status.txt
assets_list.txt

# ==========================================
# IDE
# ==========================================

.vscode/
.idea/

# ==========================================
# Operating system
# ==========================================

.DS_Store
Thumbs.db
desktop.ini

# Architecture analysis files
*.svg
*.zip
structure.txt

# Temporary scripts
cmp_docx.py
reformat_docx.py